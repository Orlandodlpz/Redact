# Copy to .env.local. The backend's origin. Set this to the deployed API for the
# hosted demo; the backend's FRONTEND_ORIGIN must name this app's origin in return.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Set to "on" for the hosted demo, so the passcode field appears. The backend's
# DEMO_PASSCODE is what actually enforces it; this only shows the field.
NEXT_PUBLIC_REQUIRE_PASSCODE=off
