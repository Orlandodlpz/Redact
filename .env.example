# Copy to .env and fill in. .env is gitignored; never commit it.

# Meta Model API key from dev.meta.ai
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Standard tier model IDs only. The server refuses to start if any model ID
# contains "contributor" (that tier trains on prompts and images).
JUDGE_MODEL=muse-spark-1.3
JUDGE_REASONING_EFFORT=low
# Unverified until the Phase 1 smoke test: sam-3.1 vs sam-3-1
SAM_MODEL=sam-3.1

# Tier 2: fill floor text pixels on our server before any Meta API call. on|off
PREMASK=off

# Must stay off. The server refuses to start if this is on.
LOG_REQUEST_BODIES=off

# Browser origins allowed to call the API, comma separated. The hosted deploy sets
# this to the frontend's origin only. "*" is refused at startup.
FRONTEND_ORIGIN=http://localhost:3000

# Hosted demo gate (backend/app/demo_gate.py). An empty or unset passcode means no
# gate, which is what local development wants; the deploy sets a real one. An empty
# value is treated as unset on purpose, so this line cannot turn the gate on with a
# passcode of "" and then admit anyone who sends an empty header.
# At about $0.06 an image, 200 a day is roughly $12 a day.
DEMO_PASSCODE=
RATE_LIMIT_PER_IP_PER_HOUR=12
DAILY_ANALYZE_CAP=200
# On only behind a proxy that sets X-Forwarded-For. Anywhere else it is spoofable.
TRUST_PROXY_HEADER=off
